/*****----- Configuration -----*****/
configuration {
    modi:                       "drun,run,filebrowser";
    show-icons:                 true;
    icon-theme:                 "Papirus";
    display-drun:               " Apps";
    display-run:                " Run";
    display-filebrowser:        " Files";
    display-window:             " Windows";
    drun-display-format:        "{name} [<span weight='light' size='small'><i>({generic})</i></span>]";
    window-format:              "{w} · {c} · {t}";
}

/*****----- Imports -----*****/
@import "./colors.rasi"
@import "./fonts.rasi"

/*****----- Main Window -----*****/
window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      700px;
    height:                     500px;
    x-offset:                   0px;
    y-offset:                   0px;
    enabled:                    true;
    margin:                     0px;
    padding:                    0px;
    border:                     0px solid;
    border-radius:              8px;
    border-color:               @subtext1;
    cursor:                     "default";
    background-color:           rgba(24, 24, 37, 0.9);
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                    true;
    spacing:                    20px;
    margin:                     0px;
    padding:                    30px;
    border:                     0px;
    border-radius:              0px;
    background-color:           transparent;
    children:                   [ "inputbar", "message", "listview", "mode-switcher" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                    true;
    spacing:                    12px;
    margin:                     0px;
    padding:                    14px;
    border:                     0px;
    border-radius:              8px;
    background-color:           @crust;
    text-color:                 @text;
    children:                   [ "prompt", "textbox-prompt-colon", "entry" ];
}

prompt {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 @mauve;
}

textbox-prompt-colon {
    enabled:                    true;
    expand:                     false;
    str:                        "::";
    background-color:           transparent;
    text-color:                 @mauve;
}

entry {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 @text;
    cursor:                     text;
    placeholder:                "Search...";
    placeholder-color:          @overlay1;
}

num-filtered-rows {
    enabled:                    true;
    expand:                     false;
    background-color:           transparent;
    text-color:                 @subtext1;
}

textbox-num-sep {
    enabled:                    true;
    expand:                     false;
    str:                        "/";
    background-color:           transparent;
    text-color:                 @subtext1;
}

num-rows {
    enabled:                    true;
    expand:                     false;
    background-color:           transparent;
    text-color:                 @subtext1;
}

case-indicator {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 @yellow;
}

/*****----- Listview -----*****/
listview {
    enabled:                    true;
    columns:                    1;
    lines:                      10;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  true;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;
    spacing:                    0px;
    margin:                     0px;
    padding:                    0px;
    border:                     0px;
    border-radius:              0px;
    background-color:           transparent;
    text-color:                 @text;
    cursor:                     "default";
}

/*****----- Scrollbar -----*****/
scrollbar {
    handle-width:               0px;
    handle-color:               @mauve;
    border-radius:              999px;
    background-color:           @surface0;
}

/*****----- Elements -----*****/
element {
    enabled:                    true;
    spacing:                    12px;
    margin:                     4px;
    padding:                    6px 14px;
    border:                     0px;
    border-radius:              8px;
    background-color:           transparent;
    text-color:                 @text;
    cursor:                     pointer;
}

element normal.normal {
    background-color:           transparent;
    text-color:                 @text;
}

element normal.urgent {
    background-color:           @red;
    text-color:                 @base;
}

element normal.active {
    background-color:           @blue;
    text-color:                 @base;
}

element selected.normal {
    background-color:           @mauve;
    text-color:                 @base;
}

element selected.urgent {
    background-color:           @peach;
    text-color:                 @base;
}

element selected.active {
    background-color:           @green;
    text-color:                 @base;
}

element alternate.normal {
    background-color:           transparent;
    text-color:                 @text;
}

element alternate.urgent {
    background-color:           @red;
    text-color:                 @base;
}

element alternate.active {
    background-color:           @blue;
    text-color:                 @base;
}

element-icon {
    background-color:           transparent;
    text-color:                 inherit;
    size:                       24px;
    cursor:                     inherit;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    highlight:                  inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}

/*****----- Mode Switcher -----*****/
mode-switcher {
    enabled:                    true;
    spacing:                    12px;
    margin:                     0px;
    padding:                    0px;
    border:                     0px;
    border-radius:              0px;
    background-color:           transparent;
    text-color:                 @text;
}

button {
    padding:                    8px 14px;
    border:                     0px;
    border-radius:              8px;
    background-color:           @surface0;
    text-color:                 @text;
    cursor:                     pointer;
}

button selected {
    background-color:           @blue;
    text-color:                 @base;
}

/*****----- Message -----*****/
message {
    enabled:                    true;
    margin:                     0px;
    padding:                    0px;
    border:                     0px;
    border-radius:              0px;
    background-color:           transparent;
    text-color:                 @text;
}

textbox {
    padding:                    10px 14px;
    border:                     0px;
    border-radius:              8px;
    background-color:           @surface0;
    text-color:                 @text;
    vertical-align:             0.5;
    horizontal-align:           0.0;
    highlight:                  none;
    placeholder-color:          @overlay1;
    blink:                      true;
    markup:                     true;
}

error-message {
    padding:                    12px;
    border:                     0px solid;
    border-radius:              8px;
    border-color:               @red;
    background-color:           @surface0;
    text-color:                 @text;
}
