(defpoll volume :interval "1s"
  "~/.config/eww/scripts/volume.sh"
)

(defwidget volume-slider []
  (box :orientation "horizontal" :space-evenly true
    (label :text "" :class "icon") ;; optional Font Awesome icon
    (scale
      :value volume
      :onchange "pamixer --set-volume {0}"
      :min 0 :max 100 :step 1
      :orientation "horizontal"
      :expand true
      :class "volume"
    )
    (label :text "${volume}%" :class "volume-label")
  )
)

(defwindow volume
  :anchor "top right"
  :geometry (geometry :x "20px" :y "20px" :width "250px" :height "40px")
  :stacking "fg"
  :exclusive false
  :visible true
  :monitor 0
  (volume-slider)
)
