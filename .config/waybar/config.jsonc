{
  "layer": "top",
  "position": "top",
  "height": 50,
  "spacing": 8,
  "margin-top": 0,

  "modules-left": [
    "custom/search",
    "custom/settings",
    "hyprland/workspaces",
    "group/media-control",
  ],
  "modules-center": ["clock", "custom/weather"],
  "modules-right": [
    "tray",
    "network",
    "bluetooth",
    "pulseaudio",
    "battery",
    "group/right-hidden-top",
  ],

  /* ---------- LEFT ---------- */
  "custom/search": {
    "format": "",
    "tooltip": false,
    "on-click": "rofi -show drun",
  },
  "custom/settings": {
    "format": "",
    "tooltip": false,
    "on-click": "",
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "on-scroll-down": "hyprctl dispatch \"hl.dsp.focus({workspace = 'e+1'})\"",
    "on-scroll-up": "hyprctl dispatch \"hl.dsp.focus({workspace = 'e-1'})\"",
    "sort-by-number": true,
    "all-outputs": true,
    "cursor": true,
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5],
    },
  },

  "group/media-control": {
    "orientation": "horizontal",
    "modules": [
      "custom/media-prev",
      "custom/media-play",
      "custom/media-next",
      "custom/media",
    ],
  },

  "custom/media-prev": {
    "format": "",
    "on-click": "playerctl previous",
    "tooltip": false,
  },

  "custom/media-play": {
    "exec": "~/.config/waybar/scripts/play-pause.sh",
    "interval": 1,
    "return-type": "json",
    "on-click": "playerctl play-pause",
    "tooltip": false,
  },

  "custom/media-next": {
    "format": "",
    "on-click": "playerctl next",
    "tooltip": false,
  },

  "custom/media": {
    "exec": "~/.config/waybar/scripts/media.sh",
    "on-click": "playerctl play-pause",
    "interval": 1,
    "return-type": "json",
  },

  /* ---------- CENTER ---------- */
  "clock": {
    "interval": 1,
    "format": "{:%H:%M:%S\n<span size='9000' foreground='#a6adc8'>%A, %d %b</span>}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "markup": true,
  },

  "custom/weather": {
    "exec": "~/.config/waybar/scripts/weather.sh",
    "on-click": "~/.config/waybar/scripts/weather.sh",
    "interval": 1800,
    "tooltip": true,
    "markup": true,
  },

  /* ---------- RIGHT ---------- */

  "tray": {
    "icon-size": 17,
    "spacing": 8,
  },

  "network": {
    "interval": 5,
    "format-wifi": "{icon}  {essid}",
    "format-ethernet": "󰈀  {ifname}",
    "format-linked": "󰈀  {ifname}",
    "format-disconnected": "󰤫  offline",
    "format-icons": ["󰤫", "󰤟", "󰤢", "󰤥", "󰤨"],

    "tooltip": true,
    "tooltip-format-wifi": "󰖩  {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}\nFreq: {frequency} MHz\nInterface: {ifname}",
    "tooltip-format-ethernet": "󰈀  Ethernet\nIP: {ipaddr}\nInterface: {ifname}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 30,

    "on-click": "kitty -e nmtui",
    "on-click-right": "nm-connection-editor",
    "on-click-middle": "kitty -e nmtui",
    "smooth-scrolling-threshold": 1,
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-on": "󰂯",
    "format-connected": "󰂱 {device_alias}",
    "format-connected-battery": "󰂱 {device_alias} | {device_battery_percentage}%",

    "tooltip": true,
    "tooltip-format": "{controller_alias}\n{controller_address}",
    "tooltip-format-connected": "{device_enumerate}",
    "max-length": 30,

    "on-click": "blueman-manager",
    "on-click-right": "rfkill toggle bluetooth",
    "smooth-scrolling-threshold": 1,
  },

  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon} {volume}%",
    "format-bluetooth": "󰂯 {volume}%",
    "format-bluetooth-muted": "󰂲 muted",
    "format-muted": "󰝟 muted",

    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "󰏲",
      "portable": "󰏲",
      "car": "󰄋",
      "default": ["󰕿", "󰖀", "󰕾"],
    },

    "tooltip": true,
    "tooltip-format": "{desc}\n{volume}%",

    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",

    "smooth-scrolling-threshold": 1,
    "max-length": 20,
  },

  "battery": {
    "states": {
      "good": 80,
      "warning": 30,
      "critical": 15,
    },

    "interval": 10,
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-full": "󰁹 100%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],

    "tooltip": true,
    "tooltip-format": "{capacity}%\n{timeTo}\n{power}W",

    "on-click": "kitty -e htop",
  },

  "group/right-hidden-top": {
    "orientation": "horizontal",
    "modules": ["group/right-hidden", "custom/ctlcenter"],
  },

  "group/right-hidden": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": true,
      "click-to-reveal": true,
    },
    "modules": ["custom/arrow-left", "memory", "temperature"],
  },

  "custom/arrow-left": {
    "format": "",
    "tooltip": false,
    "cursor": true,
  },

  "temperature": {
    "hwmon-path": "/sys/devices/platform/PNP0C14:02/wmi_bus/wmi_bus-PNP0C14:02/F1DDEE52-063C-4784-A11E-8A06684B9B01/hwmon/hwmon5/temp1_input",
    "critical-threshold": 90,
    "interval": 4,
    "format": "|  {icon} {temperatureC}°",
    "format-icons": ["", "", "", "", ""],
    "tooltip": false,
  },

  "memory": {
    "interval": 4,
    "format": "  {percentage}%",
    "states": {
      "warning": 80,
      "critical": 95,
    },
    "tooltip": "{}",
    "tooltip-format": "{used}/{total} GiB",
  },

  "custom/ctlcenter": {
    "tooltip": false,
    "format": "<span size='13000'></span>",
    "on-click": "swaync-client -t",
    "menu": "on-click-right",
    "menu-file": "~/.config/waybar/context/ctlcenter.xml",
    "menu-actions": {
      "action-1-1": "hyprctl eval \"hl.exec_cmd('alacritty -e htop')\"",
      "action-1-2": "hyprctl eval \"hl.exec_cmd('alacritty -e nvtop')\"",
      "action-1-3": "hyprctl eval \"hl.exec_cmd('alacritty -e pkexec powertop')\"",
      "action-1-4": "hyprctl eval \"hl.exec_cmd('missioncenter' )\"",

      "action-2-1": "hyprctl eval \"hl.exec_cmd('nwg-look')\"",
      "action-2-2": "hyprctl eval \"hl.exec_cmd('qt6ct')\"",
      "action-2-3": "hyprctl eval \"hl.exec_cmd('kvantummanager')\"",

      "action-3-1": "~/.local/bin/refreshrate 60",
      "action-3-2": "~/.local/bin/refreshrate 90",
      "action-3-3": "~/.local/bin/refreshrate 144",

      "action-4-1": "~/.local/bin/caffeine shutdown",
      "action-4-2": "~/.local/bin/caffeine handle-lid-switch",

      "action-5": "~/.local/bin/powersafe",
      "action-6": "hyprctl reload",
    },
  },
}
